DATABASE_URL="file:./dev.db"
AUTH_SECRET="genera-64-caracteres-hexagonales-aleatorios"
ADMIN_EMAIL="admin@ideas-moviles.com"
ADMIN_PASSWORD="cambia-esta-clave"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Carpeta donde se guardan las imágenes subidas desde el admin.
# En producción (standalone) apuntá a una carpeta persistente fuera del build.
# UPLOAD_DIR="C:/ruta/persistente/uploads"

# --- Producción (Vercel + Turso + Vercel Blob) ---
# Con TURSO_DATABASE_URL definida la app usa Turso en vez de SQLite local.
# TURSO_DATABASE_URL="libsql://xxxx-yyyy.turso.cloud"
# TURSO_AUTH_TOKEN="eyJ..."
# Con BLOB_READ_WRITE_TOKEN definida las subidas van a Vercel Blob
# (en vez de la carpeta local uploads/). Se obtiene al crear un Blob Store
# en Vercel: Storage > Blob.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
